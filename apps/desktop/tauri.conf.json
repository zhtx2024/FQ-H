{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "feiqiu-r",
  "version": "0.9.0",
  "identifier": "io.github.feiqiu-r.desktop",
  "build": {
    "frontendDist": "frontend/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "feiqiu-r",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "publisher": "feiqiu-r",
    "copyright": "feiqiu-r",
    "category": "SocialNetworking",
    "shortDescription": "局域网即时通讯(飞秋现代化重构)",
    "longDescription": "feiqiu-r:局域网即时通讯工具。自研加密协议(Ed25519 + Noise IK)、断点续传文件传输、离线消息补发。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
